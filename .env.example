# Required for AI report generation.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Only for organization-level keys that aren't scoped to a workspace.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional: docker-compose.yaml provides development defaults for everything else.
# Production must set DJANGO_SECRET_KEY, DATABASE_URL and DJANGO_ALLOWED_HOSTS explicitly.
# DJANGO_SECRET_KEY=change-me
